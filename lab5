import arcpy
import os


# TOOL INPUT PARAMETERS
# ---------------------------------------------------------

# 0 - CSV file containing garage coordinates
csv_path = arcpy.GetParameterAsText(0)

# 1 - Output geodatabase (full path to .gdb)
gdb_path = arcpy.GetParameterAsText(1)

# 2 - Buildings feature class
buildings_fc = arcpy.GetParameterAsText(2)

# 3 - Buffer distance (e.g., "10 meters")
buffer_distance = arcpy.GetParameterAsText(3)

# Folder where CSV and output CSV will be written
project_folder = os.path.dirname(gdb_path)

# 1. Create File Geodatabase 
# ---------------------------------------------------------

if not arcpy.Exists(gdb_path):
    folder = os.path.dirname(gdb_path)
    gdbname = os.path.basename(gdb_path)
    arcpy.CreateFileGDB_management(folder, gdbname)
    arcpy.AddMessage(f"Created geodatabase: {gdb_path}")
else:
    arcpy.AddMessage(f"Geodatabase already exists: {gdb_path}")


# 2. Convert CSV to XY Event Layer
# ---------------------------------------------------------

xy_layer = "garages_XYTabletoPoint"

arcpy.MakeXYEventLayer_management(
    csv_path,
    "X", "Y",
    xy_layer,
    arcpy.SpatialReference(4326)
)

arcpy.AddMessage("Created XY event layer from CSV.")

# Save XY layer into the geodatabase
garages_fc = os.path.join(gdb_path, "garages_XYTabletoPoint")

if arcpy.Exists(garages_fc):
    arcpy.Delete_management(garages_fc)

arcpy.FeatureClassToFeatureClass_conversion(xy_layer, gdb_path, "garages_XYTabletoPoint")

arcpy.AddMessage(f"Saved garage points to geodatabase: {garages_fc}")


# 3. Copy Buildings layer into the geodatabase
# ---------------------------------------------------------

buildings_in_gdb = os.path.join(gdb_path, "Structures")

if arcpy.Exists(buildings_in_gdb):
    arcpy.Delete_management(buildings_in_gdb)

arcpy.FeatureClassToFeatureClass_conversion(buildings_fc, gdb_path, "Structures")

arcpy.AddMessage("Copied buildings layer into geodatabase.")


# 4. Buffer the garage points
# ---------------------------------------------------------

buffer_output = os.path.join(gdb_path, "Garage_Buffer")

if arcpy.Exists(buffer_output):
    arcpy.Delete_management(buffer_output)

arcpy.Buffer_analysis(
    garages_fc,
    buffer_output,
    buffer_distance,
    dissolve_option="NONE"
)

arcpy.AddMessage(f"Created buffer: {buffer_output}")


# 5. Intersect buildings with garage buffers
# ---------------------------------------------------------

intersect_output = os.path.join(gdb_path, "Garage_Structures_Intersect")

if arcpy.Exists(intersect_output):
    arcpy.Delete_management(intersect_output)

arcpy.Intersect_analysis(
    [buffer_output, buildings_in_gdb],
    intersect_output
)

arcpy.AddMessage(f"Created intersect output: {intersect_output}")


# 6. Export intersect results to CSV
# ---------------------------------------------------------

csv_output = os.path.join(project_folder, "Garage_Structures_intersect.csv")

if os.path.exists(csv_output):
    os.remove(csv_output)

arcpy.TableToTable_conversion(
    intersect_output,
    project_folder,
    "Garage_Structures_intersect.csv"
)

arcpy.AddMessage(f"Exported intersect results to CSV: {csv_output}")

# ---------------------------------------------------------
arcpy.AddMessage("Workflow complete.")
