**PART ONE**
**MULTIPLY ALL ITEMS TOGETHER**
part1 = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096]

product = 1
for num in part1:
    product *= num
print(product)


**PART TWO**
**ADD ALL ITEMS TOGETHER**
part2 = [-1, 23, 483, 8573, -13847, -381569, 1652337, 718522177]

total = 0
for num in part2:
    total += num
print(total)


**PART THREE** 
**ADD ONLY THE EVEN NUMBERS**
part3 = [146, 875, 911, 83, 81, 439, 44, 5, 46, 76, 61, 68, 1, 14, 38, 26, 21]

even_total = 0
for num in part3:
    if num % 2 == 0:
        even_total += num
print(even_total)


